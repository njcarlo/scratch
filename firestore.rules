rules_version = '2';

// Owner-only access. Every document lives under users/{uid}/… so a signed-in
// user can only read and write their own health data. No public listings,
// no cross-user reads. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /{subcollection}/{docId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

function isOwner(userId) {
  return request.auth != null && request.auth.uid == userId;
}
