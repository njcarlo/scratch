# Leave these blank to run Gabay in Demo Mode (on-device localStorage).
# To use the live Firebase Spark (free) backend, copy this file to .env.local
# and fill in the web-app config from the Firebase console. See SETUP.md.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to talk to local emulators instead of a cloud project
# (npm run emulators). Dummy config values are enough when this is set.
# NEXT_PUBLIC_FIREBASE_EMULATOR=1
